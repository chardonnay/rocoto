<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.rocoto</groupId>
    <artifactId>rocoto-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>rocoto-api</artifactId>
  <name>Rocoto :: API</name>
  <description>Bootstrap, REST API v1, metrics endpoint and SSE/WebSocket streaming.</description>

  <dependencies>
    <dependency>
      <groupId>io.rocoto</groupId>
      <artifactId>rocoto-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.rocoto</groupId>
      <artifactId>rocoto-adapters</artifactId>
    </dependency>
    <dependency>
      <groupId>io.rocoto</groupId>
      <artifactId>rocoto-metrics</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.websocket</groupId>
      <artifactId>jakarta.websocket-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.websocket</groupId>
      <artifactId>jakarta.websocket-client-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/version.properties</exclude>
        </excludes>
      </resource>
    </resources>
  </build>
</project>
