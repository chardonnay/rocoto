<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>rocoto-embedded-example</artifactId>
  <version>1.0.0</version>
  <name>Rocoto example :: Undertow and Netty applications with Rocoto mounted</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <rocoto.version>0.1.0</rocoto.version>
  </properties>

  <dependencies>
    <!-- run "mvn install -DskipTests" in the repository root first -->
    <dependency>
      <groupId>io.rocoto</groupId>
      <artifactId>rocoto-undertow</artifactId>
      <version>${rocoto.version}</version>
    </dependency>
    <dependency>
      <groupId>io.rocoto</groupId>
      <artifactId>rocoto-netty</artifactId>
      <version>${rocoto.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
