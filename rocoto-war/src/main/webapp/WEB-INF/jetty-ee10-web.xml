<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">
<!--
  Jetty 12 (EE10) only. web.xml declares <login-config> (BASIC, realm "Rocoto") for
  auth.mode container/chain; Jetty refuses to start a web application with a login-config but
  without a LoginService. This registers an EMPTY fallback LoginService named "Rocoto" on the
  server: nobody can authenticate against it, Rocoto's built-in authentication is not affected.

  For auth.mode container/chain configure your own LoginService with the name "Rocoto" on the
  server (e.g. a HashLoginService in $JETTY_BASE/etc). Jetty picks the first LoginService whose
  name matches the realm, and yours is registered first.
-->
<Configure class="org.eclipse.jetty.ee10.webapp.WebAppContext">
  <Get name="server">
    <Call name="addBean">
      <Arg>
        <New class="org.eclipse.jetty.security.HashLoginService">
          <Set name="name">Rocoto</Set>
          <Set name="userStore">
            <New class="org.eclipse.jetty.security.UserStore"/>
          </Set>
        </New>
      </Arg>
    </Call>
  </Get>
</Configure>
