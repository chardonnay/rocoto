<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE glassfish-web-app PUBLIC "-//GlassFish.org//DTD GlassFish Application Server 3.1 Servlet 3.0//EN"
    "http://glassfish.org/dtds/glassfish-web-app_3_0-1.dtd">
<!-- Payara / GlassFish: map realm groups of the same name onto the Rocoto roles. -->
<glassfish-web-app>
  <context-root>/rocoto</context-root>
  <security-role-mapping>
    <role-name>rocoto-reader</role-name>
    <group-name>rocoto-reader</group-name>
  </security-role-mapping>
  <security-role-mapping>
    <role-name>rocoto-operator</role-name>
    <group-name>rocoto-operator</group-name>
  </security-role-mapping>
  <security-role-mapping>
    <role-name>rocoto-admin</role-name>
    <group-name>rocoto-admin</group-name>
  </security-role-mapping>
</glassfish-web-app>
